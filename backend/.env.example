# Supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret  # Dashboard > Settings > API > JWT Secret

# Legacy (kept for backward compatibility)
DATABASE_URL=postgresql+asyncpg://postgres.xxxxx:your-password@aws-0-region.pooler.supabase.com:6543/postgres
SECRET_KEY=your-secret-key-here-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx

# URLs (change these for production)
FRONTEND_URL=http://localhost:5173
LANDING_PAGE_URL=http://localhost:3000
BACKEND_URL=https://tenant-management-mvp.onrender.com

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# App
APP_NAME=Tenant Management System
DEBUG=True
HOST=0.0.0.0
PORT=8000

# AI / Voice
OPEN_AI_API=your-openai-api-key
GROQ_API_KEY=your-groq-api-key
PRIVATE_VAPI_API=your-vapi-api-key
VAPI_NUMBER_ID=your-vapi-number-id
VAPI_ASSISTANT_ID=your-vapi-assistant-id
