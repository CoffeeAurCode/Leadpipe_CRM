# Supabase PostgreSQL connection (get from: Settings → Database → Connection String → URI)
DATABASE_URL=postgresql+asyncpg://postgres.xxxxx:your-password@aws-0-region.pooler.supabase.com:6543/postgres
SECRET_KEY=your-secret-key-here-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

APP_NAME=Tenant Management System
DEBUG=True
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
HOST=0.0.0.0
PORT=8000
