# ── Auth ─────────────────────────────────────────────────────────────────────
# Supabase access_token.
# Local:  DevTools → Application → Local Storage → http://localhost:5173
#         → key sb-nfgnxndktecqeleabbip-auth-token → access_token
# Hosted: same steps but open the hosted frontend URL instead.
AUTH_TOKEN=eyJ...

# Optional: refresh_token from the same localStorage entry.
# Providing it lets the test session auto-renew if access_token is close to expiry.
# REFRESH_TOKEN=your-refresh-token

# ── Target environment (omit for localhost defaults) ──────────────────────────
# FRONTEND_URL=https://your-app.vercel.app
# BACKEND_URL=https://your-api.railway.app
