# Supabase access_token (Bearer token from DevTools → Application → Local Storage
# → sb-nfgnxndktecqeleabbip-auth-token → access_token)
AUTH_TOKEN=eyJ...

# Optional: refresh_token from the same localStorage entry.
# Providing it lets the test session auto-renew if the access_token is close to expiry.
# REFRESH_TOKEN=your-refresh-token
